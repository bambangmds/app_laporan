# =========================================================================
# KONFIGURASI DATABASE MYSQL & EXPRESS - SALESFLOW
# =========================================================================

# Port untuk server backend Express (Default: 3000)
PORT=3000

# Pengaturan Koneksi Database MySQL Anda:
# Isi nilai di bawah ini untuk mengaktifkan koneksi ke database fisik Anda.
# Jika dibiarkan kosong, aplikasi akan otomatis berjalan menggunakan Sandbox JSON Lokal.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_penjualan
